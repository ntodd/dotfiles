    "check-key": "$HOME/.claude/skills/product-film/scripts/check-openrouter-key.sh .env",
    "clips": "tsx pipeline/gen-visuals.ts clips",
    "dry-run": "pipeline/dry-run.sh",
    "images": "tsx pipeline/gen-visuals.ts images",
    "music": "tsx pipeline/gen-audio.ts music",
