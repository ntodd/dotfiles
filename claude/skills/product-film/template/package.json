    "publish": "tsx pipeline/publish.ts",
    "render": "pipeline/render.sh",
    "review": "tsx pipeline/review.ts",
    "sfx": "uv run --quiet pipeline/make_sfx.py",
    "studio": "remotion studio src/index.ts",
    "timeline": "tsx pipeline/build-timeline.ts",
    "typecheck": "tsc --noEmit",
    "voice": "tsx pipeline/gen-audio.ts voice"
  },
