# A dedicated OpenRouter key for this film: WITH a credit limit (about $15-30)
# and an expiration (about 7-14 days). Create it at
# https://openrouter.ai/settings/keys, then run `npm run check-key`.
OPENROUTER_API_KEY=

# Public media bucket for publishing the film (optional; see pipeline/publish.ts).
# MEDIA_AWS_ACCESS_KEY_ID=
# MEDIA_AWS_SECRET_ACCESS_KEY=
# MEDIA_AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# MEDIA_AWS_REGION=auto
# MEDIA_BUCKET_NAME=
