{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": [
      "Skill(codex-discussion)",
      "Bash(mix test)",
      "Bash(mix test:*)",
      "Bash(mix format)",
      "Bash(mix format:*)",
      "Bash(mix compile)",
      "Bash(mix compile:*)",
      "Bash(mix credo:*)",
      "Bash(mix deps:*)",
      "Bash(mix help:*)",
      "Bash(mix hex.info:*)",
      "Bash(iex:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "WebFetch(domain:hexdocs.pm)",
      "Bash(~/.claude/skills/codex-discussion/scripts/check-codex.sh)",
      "Bash(~/.claude/skills/codex-discussion/scripts/discuss.sh:*)",
      "Bash(CODEX_CONTEXT_DIR:*)",
      "Bash(CODEX_MODEL:*)",
      "Bash(git reset --hard:*)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/humanize-reminder.sh",
            "if": "Bash(gh *)",
            "statusMessage": "Checking for humanizer reminder..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"$HOME/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"$HOME/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/vscode/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true
}
